# Copy this file to ".env" and fill in your TMDB credentials.
# Get a free key at https://www.themoviedb.org/settings/api
# Either the "API Key" (v3, 32 chars) or the "API Read Access Token" (v4, starts with eyJ) works.
TMDB_API_KEY=your_tmdb_api_key_here

# Port for the local server (hosting services usually set PORT themselves)
PORT=7000

# ---- Optional settings (defaults shown) ----

# Language used for titles/overviews returned by TMDB
# TMDB_LANGUAGE=en-US

# Movies per catalog page returned to Stremio
# PAGE_SIZE=40

# Minimum TMDB vote count for the "Top Rated" catalog (filters out 1-vote 10/10 entries)
# MIN_VOTES_TOP_RATED=20

# How long catalog/search results are cached, in minutes
# CACHE_TTL_MINUTES=30

# If true, movies with no IMDb ID are still listed using "tmdb:<id>" IDs.
# Default false so every item works with Torrentio / AIOStreams.
# INCLUDE_WITHOUT_IMDB=false

# If true, TMDB's rating is shown in Stremio's rating badge (which carries an IMDb logo).
# Default false: the TMDB rating is shown at the top of the description instead.
# SHOW_TMDB_RATING_AS_IMDB_RATING=false

# Where the TMDB->IMDb ID cache is stored. Set to "off" to disable the disk cache.
# ID_MAP_PATH=./data/id-map.json

# ---- Optional / deployment settings ----

# Max milliseconds one catalog request may spend loading TMDB pages once it has something to return
# REQUEST_BUDGET_MS=8000

# TMDB request timeout in ms (defaults: 10000 locally, 8000 on Vercel)
# TMDB_TIMEOUT_MS=10000

# Read-only starting data for the id cache, created by "npm run export-id-map" ("off" disables)
# ID_MAP_SEED_PATH=./seed/id-map.seed.json
